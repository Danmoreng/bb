{
  "name": "bb-plugin-control-plane-spike",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Disposable capability spike for the bb Control Plane.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Control Plane Spike",
